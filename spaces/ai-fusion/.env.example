# AI-Fusion Space — environment template.
#
# Copy to .env for local runs. Nothing here is a secret; real tokens belong in the
# Space's Secrets, never in a file that can reach git.

# --- governance -------------------------------------------------------------
# enforce  = callers must present identity, session, provenance and capabilities
# permissive = local development only; responses say governance_enforced: false
NLT_GOVERNANCE_MODE=permissive
NLT_GOVERNANCE_VERSION=ORG-DEV-OTOI-1.0.3

# --- decision source --------------------------------------------------------
# baseline needs no model. gguf/transformers require the path below to exist.
FUSION_AGENT_LOOP_MODEL=baseline
# FUSION_AGENT_LOOP_MODEL=gguf
# FUSION_GGUF_MODEL=/data/models/model.gguf
# FUSION_AGENT_LOOP_MODEL=transformers
# FUSION_TRANSFORMERS_MODEL=/data/models/student
FUSION_AGENT_LOOP_TIMEOUT=15
# FUSION_AGENT_LOOP_HISTORY=8

# --- http -------------------------------------------------------------------
PORT=7860
# ALLOWED_ORIGINS=https://app.neuroliftsolutions.com

# --- storage ----------------------------------------------------------------
NLT_ARTIFACTS_DIR=/data
NEUROLIFT_MODELS_DIR=/data/models
# Durable state is external. Set these as Space Secrets, never here:
# SUPABASE_URL=
# SUPABASE_KEY=

# --- identity of this deployment -------------------------------------------
SPACE_REPO_ID=divergent-tech/Ai-fusion
NLT_ENVIRONMENT=development
