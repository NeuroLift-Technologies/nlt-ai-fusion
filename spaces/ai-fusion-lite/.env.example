# NeuroLift AI-Fusion Lite CPU Space - Environment Configuration
#
# Copy this file to .env in your Space for local testing.
# On Hugging Face Spaces, set these as Space Variables/Secrets instead.

# Decision source: gguf (for GGUF model inference on CPU)
FUSION_AGENT_LOOP_MODEL=gguf

# Path to your GGUF model file (REQUIRED for gguf mode)
# Upload your model to /data/models/ in the Space, then set this to the full path
FUSION_GGUF_MODEL=/data/models/qwen2.5-0.6b-instruct-q4_k_m.gguf

# Directory for model checkpoints
NEUROLIFT_MODELS_DIR=/data/models

# Timeout for each decision (seconds) - must be < 30 for Godot compatibility
# Increase if using larger models on CPU (but may hit Godot's 30s limit)
FUSION_AGENT_LOOP_TIMEOUT=20

# How many past decisions each agent remembers
FUSION_AGENT_LOOP_HISTORY=10

# CORS origins (comma-separated, leave empty for all in dev)
ALLOWED_ORIGINS=

# Governance mode: enforce (default) or permissive
NLT_GOVERNANCE_MODE=permissive

# Governance version accepted from callers
NLT_GOVERNANCE_VERSION=ORG-DEV-OTOI-1.0.3
