# NeuroLift AI-Fusion ZeroGPU Space - Environment Configuration
#
# Copy this file to .env in your Space for local testing.
# On Hugging Face Spaces, set these as Space Variables/Secrets instead.

# Decision source: baseline (deterministic, no model needed)
FUSION_AGENT_LOOP_MODEL=baseline

# Timeout for each decision (seconds) - must be < 30 for Godot compatibility
FUSION_AGENT_LOOP_TIMEOUT=15

# How many past decisions each agent remembers
FUSION_AGENT_LOOP_HISTORY=10

# CORS origins (comma-separated, leave empty for all in dev)
ALLOWED_ORIGINS=

# Governance mode: enforce (default) or permissive
NLT_GOVERNANCE_MODE=permissive

# Governance version accepted from callers
NLT_GOVERNANCE_VERSION=ORG-DEV-OTOI-1.0.3
